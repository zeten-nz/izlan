# Izlan backend — environment example. REAL parol/secret/pepper YO'Q.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/izlan_dev?schema=public

# Test DB (integration testlar — izolyatsiyalangan; DATABASE_URL'dan boshqa bo'lishi shart)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/izlan_test?schema=public

# Auth — OTP pepper MAJBURIY (production'da >=24 char, kuchli tasodifiy). PLACEHOLDER faqat.
AUTH_OTP_PEPPER=CHANGE_ME_STRONG_RANDOM_SECRET
# Auth tuning (implementation, product qarori emas — default'lar env.validation'da)
# AUTH_OTP_TTL_SECONDS=180
# AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
# AUTH_OTP_MAX_ATTEMPTS=5
# AUTH_OTP_PHONE_HOURLY_LIMIT=5
# AUTH_OTP_PHONE_DAILY_LIMIT=10
# AUTH_SESSION_IDLE_TTL_DAYS=30
# AUTH_SESSION_ABSOLUTE_TTL_DAYS=90

# Local dev: the Methodist CMS web app (izlan/web) runs on :4000, this API on :3000.
# CORS_ORIGINS=http://localhost:4000,http://localhost:3001
# TRUST_PROXY=false

# Access JWT (RS256) — PLACEHOLDER faqat. Keylar: `npm run generate:jwt-keys` (README).
# Private key HECH QACHON commit qilinmaydi. base64-encoded PEM (multiline-env muammosini oldini oladi).
AUTH_JWT_ACTIVE_KID=key-2026-01
AUTH_JWT_PRIVATE_KEY_B64=<base64-encoded-RSA-PKCS8-private-PEM>
AUTH_JWT_PUBLIC_KEYS_JSON={"key-2026-01":"<base64-encoded-RSA-SPKI-public-PEM>"}
AUTH_JWT_ISSUER=izlan
AUTH_JWT_AUDIENCE=izlan-web
# AUTH_ACCESS_TTL_SECONDS=900

# Refresh cookie — production'da MAJBURIY true; dev/localhost false.
AUTH_COOKIE_SECURE=false
# AUTH_OTP_IP_HOURLY_LIMIT=10
# Phone+password login protection (TD-252) — per source IP / per canonical phone (defaults in env.validation).
# AUTH_LOGIN_IP_HOURLY_LIMIT=30
# AUTH_LOGIN_PHONE_HOURLY_LIMIT=10

# SMS driver (TD-252). Default = provider-unavailable (safe). `console` prints OTP codes to the server log for
# LOCAL registration / password-reset — DEV ONLY (startup FAILS if NODE_ENV=production). Never store token/hash/pepper.
# SMS_DRIVER=console

# Demo seed (`npm run db:seed:demo`, §17-20) — DEV/staging only. Refuses production; requires ALLOW_DEMO_SEED=true.
# Demo passwords are read from env (never committed) and hashed via the production Argon2id hasher.
# ALLOW_DEMO_SEED=true
# DEMO_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ONLY
# DEMO_METHODIST_PASSWORD=CHANGE_ME_LOCAL_ONLY
