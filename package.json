    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "db:seed:system": "ts-node src/bootstrap/seed-system.ts",
    "db:seed:demo": "ts-node src/bootstrap/seed-demo.ts",
    "db:seed:runtime": "ts-node src/bootstrap/seed-runtime.ts",
    "db:prepare:investor-demo": "ts-node src/bootstrap/prepare-investor-demo.ts",
