// Izlan.uz — Prisma Schema v1 (Phase 1.3)
// Datasource + generator + shared enums.
// Domain models: core.prisma, content.prisma, learning.prisma, finance.prisma, community.prisma
//
// Source of truth: TECH_DECISIONS.md (TD-01..TD-92), DB_CONSTRAINT_MATRIX.md, JSONB_GOVERNANCE.md.
// Constraints Prisma ifodalay olmaydigan joylar (CHECK, partial unique, append-only PRIV) —
// migration/postgres_constraints.sql da; DB_CONSTRAINT_MATRIX.md Phase 1.3 mapping'i bilan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL prisma.config.ts (datasource.url) da.
  // relationMode default ("foreignKeys") — PostgreSQL FK integrity DB tomonidan enforce qilinadi (§5).
}

