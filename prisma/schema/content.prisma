// Izlan — Content domain (TD-06/07/08/09/20/21/22/24/27/28/82)
// Explicit hierarchy: Subject → Track → Level → Module → Topic → Lesson → LessonRevision → Activity
// + Skill, LessonSkill, ActivitySkill, LessonPrerequisite, ActivityMedia.

model Subject {
  id          String          @id @default(uuid(7)) @db.Uuid
  slug        String          @unique
  title       String
  description String?
  status      ContainerStatus @default(DRAFT)
  sortOrder   Int             @default(0) @map("sort_order")
  createdBy   String          @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  createdByUser         User                    @relation("SubjectCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  tracks                Track[]
  skills                Skill[]
  assignments           SubjectAssignment[]
  assessmentDefinitions AssessmentDefinition[]
  checkpoints           Checkpoint[]
  roadmaps              LearnerRoadmap[]
  communityPosts        CommunityPost[]
  signals               LearnerSignal[]
  learningIntents       LearnerLearningIntent[]
  subjectDomains        SubjectDomain[] // V2 Wave A
  placementDecisions    PlacementDecision[] // V2 Wave C
  roadmapGenerations    LearnerRoadmapGeneration[] // V2 Wave D

  @@map("subject")
}

model Track {
  id          String          @id @default(uuid(7)) @db.Uuid
  subjectId   String          @map("subject_id") @db.Uuid
  slug        String
  title       String
  description String?
  status      ContainerStatus @default(DRAFT)
  sortOrder   Int             @default(0) @map("sort_order")
  createdBy   String          @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  subject         Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdByUser   User                    @relation("TrackCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  levels          Level[]
  roadmaps        LearnerRoadmap[]
  learningIntents LearnerLearningIntent[]
  placementDecisions PlacementDecision[] // V2 Wave C
  roadmapGenerations LearnerRoadmapGeneration[] // V2 Wave D

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@map("track")
}

model Level {
  id        String          @id @default(uuid(7)) @db.Uuid
  trackId   String          @map("track_id") @db.Uuid
  code      String // display code ("B1"); enum EMAS — data (TD-27)
  title     String
  sortOrder Int             @map("sort_order")
  status    ContainerStatus @default(DRAFT)
  createdBy String          @map("created_by") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  track         Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)
  createdByUser User     @relation("LevelCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  modules       Module[]

  skillLevelExpectations SkillLevelExpectation[] // V2 Wave A (SQ1 — Level reused as progression identity)
  roadmapPoints          RoadmapPoint[] // V2 Wave B
  placementRecommendations PlacementDecision[]   @relation("PlacementRecommendedLevel") // V2 Wave C

  @@unique([trackId, code])
  @@unique([trackId, sortOrder])
  @@index([trackId])
  @@map("level")
}

model Module {
  id          String          @id @default(uuid(7)) @db.Uuid
  levelId     String          @map("level_id") @db.Uuid
  title       String
  description String?
  sortOrder   Int             @map("sort_order")
  status      ContainerStatus @default(DRAFT)
  createdBy   String          @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  level         Level       @relation(fields: [levelId], references: [id], onDelete: Restrict)
  createdByUser User        @relation("ModuleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  topics        Topic[]
  checkpoint    Checkpoint? // Module 1:0..1 Checkpoint (TD-41)

  @@unique([levelId, sortOrder])
  @@index([levelId])
  @@map("module")
}

model Topic {
  id          String          @id @default(uuid(7)) @db.Uuid
  moduleId    String          @map("module_id") @db.Uuid
  title       String
  description String?
  sortOrder   Int             @map("sort_order")
  status      ContainerStatus @default(DRAFT)
  createdBy   String          @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  module         Module          @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  createdByUser  User            @relation("TopicCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  lessons        Lesson[]
  communityPosts CommunityPost[]
  roadmapPointRevisions RoadmapPointRevision[] // V2 Wave B (optional content-reuse link)

  @@unique([moduleId, sortOrder])
  @@index([moduleId])
  @@map("topic")
}

// Lesson = logical identity (TD-24); publishedRevisionId — circular pointer (§14).
model Lesson {
  id                  String       @id @default(uuid(7)) @db.Uuid
  topicId             String       @map("topic_id") @db.Uuid
  // Phase 2.2A-D (TD-244): immutable stable business/import identity — DISTINCT from `id` (internal DB identity), `slug`
  // (future routing/SEO), and `title` (mutable, on LessonRevision). NOT NULL + globally UNIQUE. Supplied by the future
  // import/authoring layer (no generation service here). Immutability is an authoring-service contract, NOT a DB trigger:
  // the future Phase 2.2A writer must treat contentKey as immutable and never expose it as an ordinary mutable field.
  contentKey          String       @unique @map("content_key")
  slug                String?
  sortOrder           Int          @map("sort_order")
  status              LessonStatus @default(DRAFT)
  publishedRevisionId String?      @unique @map("published_revision_id") @db.Uuid
  createdBy           String       @map("created_by") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  topic             Topic                     @relation(fields: [topicId], references: [id], onDelete: Restrict)
  createdByUser     User                      @relation("LessonCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  // Circular: pointer joriy learner-visible revisionga (invariant C6: shu lesson'ning revisioni — app/DB enforce)
  publishedRevision LessonRevision?           @relation("LessonPublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: Restrict)
  revisions         LessonRevision[]          @relation("LessonRevisions")
  skills            LessonSkill[]
  prerequisites     LessonPrerequisite[]      @relation("PrereqLesson")
  requiredBy        LessonPrerequisite[]      @relation("PrereqRequiredLesson")
  progress          LearnerLessonProgress[]
  completions       LearnerLessonCompletion[]
  reviewSessions    LearnerReviewSession[]

  @@index([topicId, status])
  @@map("lesson")
}

// LessonRevision = immutable content versiyasi (TD-24). REVIEW state shu yerda (TD-28).
model LessonRevision {
  id                   String         @id @default(uuid(7)) @db.Uuid
  lessonId             String         @map("lesson_id") @db.Uuid
  version              Int
  title                String
  description          String?
  estimatedDurationMin Int?           @map("estimated_duration_min") // activity durationlardan cache
  status               RevisionStatus @default(DRAFT)
  createdBy            String         @map("created_by") @db.Uuid
  updatedBy            String?        @map("updated_by") @db.Uuid
  reviewedBy           String?        @map("reviewed_by") @db.Uuid
  publishedBy          String?        @map("published_by") @db.Uuid
  publishedAt          DateTime?      @map("published_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  lesson             Lesson                    @relation("LessonRevisions", fields: [lessonId], references: [id], onDelete: Restrict)
  createdByUser      User                      @relation("RevisionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser      User?                     @relation("RevisionUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  reviewedByUser     User?                     @relation("RevisionReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  publishedByUser    User?                     @relation("RevisionPublishedBy", fields: [publishedBy], references: [id], onDelete: SetNull)
  activities         Activity[]
  publishedForLesson Lesson?                   @relation("LessonPublishedRevision")
  activityAttempts   ActivityAttempt[]
  lessonProgress     LearnerLessonProgress[]
  lessonCompletions  LearnerLessonCompletion[]
  reviewSessions     LearnerReviewSession[]
  blueprintBindings  TeachingBlueprintContentBinding[] // V2 Wave B
  teachingSessionPins TeachingSessionContentPin[] // V2 Wave C
  taskMeasurements   SkillMeasurement[]               @relation("MeasurementTaskContentRevision") // V2 Wave C
  sourceProvenance   ContentSourceProvenance[] // Content Quality V2
  contentReviews     ContentReview[] // Content Quality V2
  qualityIssues      ContentQualityIssue[] // Content Quality V2
  integrityScopes    EvidenceIntegrityScope[] // Content Quality V2

  @@unique([lessonId, version])
  @@index([lessonId, status])
  @@map("lesson_revision")
}

// Activity = single table + type + JSONB payload (TD-21/22). Media — junctionda (TD-82).
model Activity {
  id                   String        @id @default(uuid(7)) @db.Uuid
  lessonRevisionId     String        @map("lesson_revision_id") @db.Uuid
  type                 ActivityType
  position             Int
  estimatedDurationMin Int?          @map("estimated_duration_min")
  payload              Json          @db.JsonB // TD-21/22/92 — media_asset_id YO'Q (role/config only)
  source               ContentSource @default(HUMAN) // TD-20
  aiMetadata           Json?         @map("ai_metadata") @db.JsonB // TD-24/92
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  revision LessonRevision    @relation(fields: [lessonRevisionId], references: [id], onDelete: Cascade) // draft revision cascade; published — app immutable
  media    ActivityMedia[]
  skills   ActivitySkill[]
  attempts ActivityAttempt[]
  reviewSessionActivities LearnerReviewSessionActivity[]
  blueprintBindings   TeachingBlueprintContentBinding[] // V2 Wave B
  teachingSessionPins TeachingSessionContentPin[] // V2 Wave C
  qualityIssues       ContentQualityIssue[] // Content Quality V2
  integrityScopes     EvidenceIntegrityScope[] // Content Quality V2

  @@unique([lessonRevisionId, position])
  @@index([lessonRevisionId])
  @@map("activity")
}

// ActivityMedia (TD-82) — asset association relational truth
model ActivityMedia {
  id           String   @id @default(uuid(7)) @db.Uuid
  activityId   String   @map("activity_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  roleCode     String?  @map("role_code") // closed registry (kerak bo'lsa)
  position     Int
  altText      String?  @map("alt_text") // learner-facing alt text for THIS attachment context (image alt / audio label); nullable at DB, IMAGE requires non-empty at the domain layer; never a URL
  createdAt    DateTime @default(now()) @map("created_at")

  activity Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict) // referenced → RESTRICT (I-15)

  @@unique([activityId, mediaAssetId])
  @@index([mediaAssetId])
  @@map("activity_media")
}

// Skill — Subject 1:N Skill (TD-07)
model Skill {
  id          String      @id @default(uuid(7)) @db.Uuid
  subjectId   String      @map("subject_id") @db.Uuid
  name        String
  code        String? // recommended barqaror identifikator
  description String?
  sortOrder   Int         @default(0) @map("sort_order")
  status      SkillStatus @default(ACTIVE)
  // V2 Wave A: OPTIONAL primary domain (nullable, backfilled by Methodist in Wave F).
  // Skill remains SUBJECT-scoped via subjectId (authoritative); this is additive only.
  // App invariant (not DB): primaryDomain.subjectId == skill.subjectId (cross-subject guard).
  primaryDomainId String?  @map("primary_domain_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  subject           Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  primaryDomain     SubjectDomain?      @relation(fields: [primaryDomainId], references: [id], onDelete: Restrict) // V2 Wave A
  lessons           LessonSkill[]
  activities        ActivitySkill[]
  assessmentItems   AssessmentItem[]
  skillStates       LearnerSkillState[]
  skillMeasurements SkillMeasurement[]
  roadmapItems      RoadmapItem[]
  signals           LearnerSignal[]
  reviewSessions    LearnerReviewSession[]
  skillLevelExpectations SkillLevelExpectation[] // V2 Wave A

  @@unique([subjectId, name])
  @@unique([subjectId, code])
  @@index([subjectId])
  @@map("skill")
}

model LessonSkill {
  id       String @id @default(uuid(7)) @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid
  skillId  String @map("skill_id") @db.Uuid

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([lessonId, skillId])
  @@index([skillId])
  @@map("lesson_skill")
}

model ActivitySkill {
  id         String @id @default(uuid(7)) @db.Uuid
  activityId String @map("activity_id") @db.Uuid
  skillId    String @map("skill_id") @db.Uuid

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([activityId, skillId])
  @@index([skillId])
  @@map("activity_skill")
}

// LessonPrerequisite — explicit prerequisite edges (TD-29). Phase 2.2A-D (TD-245): a DB CHECK
// (chk_lesson_prerequisite_no_self_loop, custom SQL) enforces ONLY the direct self-loop invariant
// lesson_id <> prerequisite_lesson_id. A row-level CHECK CANNOT detect a multi-node DAG cycle (A→B→C→A) — full DAG
// cycle prevention belongs to the future Phase 2.2A authoring service (transactional write-time validation), NOT the DB.
model LessonPrerequisite {
  id                   String   @id @default(uuid(7)) @db.Uuid
  lessonId             String   @map("lesson_id") @db.Uuid
  prerequisiteLessonId String   @map("prerequisite_lesson_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")

  lesson             Lesson @relation("PrereqLesson", fields: [lessonId], references: [id], onDelete: Cascade)
  prerequisiteLesson Lesson @relation("PrereqRequiredLesson", fields: [prerequisiteLessonId], references: [id], onDelete: Restrict)

  @@unique([lessonId, prerequisiteLessonId])
  @@index([prerequisiteLessonId])
  @@map("lesson_prerequisite")
}

// ============================================================================
// V2 CANONICAL CURRICULUM — WAVE A (docs/learning-v2/DATA_MODEL_V2_PRISMA_CHANGE_PLAN.md §5–§6)
// Additive-only. No V1 model semantics change. Methodist-authored; archive-first (Restrict).
// Only the skill/progression foundation. RoadmapPoint / blueprints / mastery come in later waves.
// ============================================================================

// SubjectDomain — subject-scoped competence domain (English: Grammar…Pronunciation). Lookup taxonomy.
model SubjectDomain {
  id          String      @id @default(uuid(7)) @db.Uuid
  subjectId   String      @map("subject_id") @db.Uuid
  code        String // stable identifier, unique per subject; non-empty (CHECK chk_subject_domain_code_nonempty)
  name        String
  description String?
  sortOrder   Int         @default(0) @map("sort_order")
  status      SkillStatus @default(ACTIVE) // reuse {ACTIVE, ARCHIVED}
  createdBy   String      @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  subject       Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdByUser User    @relation("SubjectDomainCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  skills        Skill[] // Skill.primaryDomain back-relation

  @@unique([subjectId, code])
  @@index([subjectId])
  @@map("subject_domain")
}

// SkillLevelExpectation — stable identity: ONE Skill at ONE progression Level (correction 1).
// Lifecycle facets (introduced/expected/reinforced/assessed/required-for-exit) are VERSIONED on the
// revision, NOT part of this identity key. Circular current-published pointer mirrors Lesson/AssessmentDefinition.
model SkillLevelExpectation {
  id                String   @id @default(uuid(7)) @db.Uuid
  skillId           String   @map("skill_id") @db.Uuid
  levelId           String   @map("level_id") @db.Uuid
  currentRevisionId String?  @unique @map("current_revision_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  skill           Skill                           @relation(fields: [skillId], references: [id], onDelete: Restrict)
  level           Level                           @relation(fields: [levelId], references: [id], onDelete: Restrict)
  currentRevision SkillLevelExpectationRevision?  @relation("ExpectationCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  revisions       SkillLevelExpectationRevision[] @relation("ExpectationRevisions")
  roadmapPointExpectations RoadmapPointSkillExpectation[] // V2 Wave B

  @@unique([skillId, levelId])
  @@index([skillId])
  @@index([levelId])
  @@map("skill_level_expectation")
}

// SkillLevelExpectationRevision — immutable published revision. Facets are explicit BOOLEANS (correction 1).
// Historical SkillMeasurement / MasteryRequirement pins THIS revision id (later waves), never the identity alone.
model SkillLevelExpectationRevision {
  id                    String         @id @default(uuid(7)) @db.Uuid
  expectationId         String         @map("expectation_id") @db.Uuid
  versionNo             Int            @map("version_no")
  status                RevisionStatus @default(DRAFT)
  isIntroduced          Boolean        @default(false) @map("is_introduced")
  isExpected            Boolean        @default(false) @map("is_expected")
  isReinforced          Boolean        @default(false) @map("is_reinforced")
  isAssessed            Boolean        @default(false) @map("is_assessed")
  isRequiredForExit     Boolean        @default(false) @map("is_required_for_exit")
  requiredEvidenceKinds Json           @map("required_evidence_kinds") @db.JsonB // evidence-kind registry strings
  minIndependence       Int?           @map("min_independence") @db.SmallInt // ordinal; >= 0 (CHECK)
  criticality           Int            @default(0) @db.SmallInt // ordinal exit-weight; >= 0 (CHECK)
  descriptor            Json?          @db.JsonB // can-do descriptor
  reviewedBy            String?        @map("reviewed_by") @db.Uuid
  publishedBy           String?        @map("published_by") @db.Uuid
  publishedAt           DateTime?      @map("published_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  expectation           SkillLevelExpectation  @relation("ExpectationRevisions", fields: [expectationId], references: [id], onDelete: Restrict)
  currentForExpectation SkillLevelExpectation? @relation("ExpectationCurrentRevision")
  reviewedByUser        User?                  @relation("ExpectationRevReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  publishedByUser       User?                  @relation("ExpectationRevPublishedBy", fields: [publishedBy], references: [id], onDelete: SetNull)
  masteryReqExpectations MasteryRequirementSkillExpectation[] // V2 Wave B
  skillMeasurements     SkillMeasurement[] // V2 Wave C (measurements pin this revision)
  placementValidations  PlacementDecisionValidation[] // Placement V2 (expectation-target)

  @@unique([expectationId, versionNo])
  @@map("skill_level_expectation_revision")
}

// ============================================================================
// V2 CANONICAL CURRICULUM — WAVE B (roadmap-point graph, teaching blueprint, mastery requirement)
// docs/learning-v2/DATA_MODEL_V2_PRISMA_CHANGE_PLAN.md §7–§9. Additive; RoadmapPoint != Lesson.
// ============================================================================

// RoadmapPoint — stable canonical concept identity (survives regeneration & graph revisions).
// Sole ownership FK is levelId; Subject/Track derived via level->track->subject (correction 2).
model RoadmapPoint {
  id                  String          @id @default(uuid(7)) @db.Uuid
  pointKey            String          @unique @map("point_key") // globally stable business key (like Lesson.contentKey)
  levelId             String          @map("level_id") @db.Uuid
  status              ContainerStatus @default(DRAFT)
  publishedRevisionId String?         @unique @map("published_revision_id") @db.Uuid
  createdBy           String          @map("created_by") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  level             Level                  @relation(fields: [levelId], references: [id], onDelete: Restrict)
  createdByUser     User                   @relation("RoadmapPointCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  publishedRevision RoadmapPointRevision?  @relation("RoadmapPointPublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: Restrict)
  revisions         RoadmapPointRevision[] @relation("RoadmapPointRevisions")
  prereqOwnerRows   RoadmapPointPrerequisite[] @relation("RoadmapPointPrereqOwner")
  prereqTargetRows  RoadmapPointPrerequisite[] @relation("RoadmapPointPrereqTarget")
  teachingBlueprint TeachingBlueprint?
  masteryRequirement MasteryRequirement?
  teachingSessions  TeachingSession[]
  masteryEvaluations MasteryEvaluation[]
  acquisitionEvents PointAcquisitionEvent[]
  projections       RoadmapPointProjection[]
  placementValidations PlacementDecisionValidation[] // Placement V2

  @@index([levelId])
  @@map("roadmap_point")
}

// RoadmapPointRevision — immutable published graph-version. Owns membership + prerequisite edges.
model RoadmapPointRevision {
  id                String         @id @default(uuid(7)) @db.Uuid
  roadmapPointId    String         @map("roadmap_point_id") @db.Uuid
  versionNo         Int            @map("version_no")
  status            RevisionStatus @default(DRAFT)
  title             String
  learningOutcome   Json?          @map("learning_outcome") @db.JsonB
  topicId           String?        @map("topic_id") @db.Uuid // optional content-reuse link (versioned)
  sortOrderDefault  Int            @map("sort_order_default")
  requiredFlag      Boolean        @default(true) @map("required_flag")
  estimatedEffortMin Int?          @map("estimated_effort_min")
  reviewedBy        String?        @map("reviewed_by") @db.Uuid
  publishedBy       String?        @map("published_by") @db.Uuid
  publishedAt       DateTime?      @map("published_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  point           RoadmapPoint  @relation("RoadmapPointRevisions", fields: [roadmapPointId], references: [id], onDelete: Restrict)
  currentForPoint RoadmapPoint? @relation("RoadmapPointPublishedRevision")
  topic           Topic?        @relation(fields: [topicId], references: [id], onDelete: Restrict)
  reviewedByUser  User?         @relation("RoadmapPointRevReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  publishedByUser User?         @relation("RoadmapPointRevPublishedBy", fields: [publishedBy], references: [id], onDelete: SetNull)
  prerequisites   RoadmapPointPrerequisite[]    @relation("RevisionPrerequisites")
  skillExpectations RoadmapPointSkillExpectation[]
  teachingSessions  TeachingSession[]
  masteryEvaluations MasteryEvaluation[]
  acquisitionEvents PointAcquisitionEvent[]
  projections       RoadmapPointProjection[]
  placementValidations PlacementDecisionValidation[] // Placement V2 (point-target)
  sourceProvenance  ContentSourceProvenance[] // Content Quality V2
  contentReviews    ContentReview[] // Content Quality V2
  qualityIssues     ContentQualityIssue[] // Content Quality V2

  @@unique([roadmapPointId, versionNo])
  @@index([roadmapPointId, status])
  @@map("roadmap_point_revision")
}

// RoadmapPointPrerequisite — prerequisite edge owned by a point revision (history-frozen).
// roadmapPointId is denormalized so the no-self-loop CHECK is a row CHECK.
model RoadmapPointPrerequisite {
  id                     String   @id @default(uuid(7)) @db.Uuid
  roadmapPointRevisionId String   @map("roadmap_point_revision_id") @db.Uuid
  roadmapPointId         String   @map("roadmap_point_id") @db.Uuid
  prerequisitePointId    String   @map("prerequisite_point_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")

  revision         RoadmapPointRevision @relation("RevisionPrerequisites", fields: [roadmapPointRevisionId], references: [id], onDelete: Cascade)
  point            RoadmapPoint         @relation("RoadmapPointPrereqOwner", fields: [roadmapPointId], references: [id], onDelete: Restrict)
  prerequisitePoint RoadmapPoint        @relation("RoadmapPointPrereqTarget", fields: [prerequisitePointId], references: [id], onDelete: Restrict)

  @@unique([roadmapPointRevisionId, prerequisitePointId])
  @@index([prerequisitePointId])
  @@map("roadmap_point_prerequisite")
}

// RoadmapPointSkillExpectation — point-revision membership referencing the STABLE expectation identity.
model RoadmapPointSkillExpectation {
  id                      String                @id @default(uuid(7)) @db.Uuid
  roadmapPointRevisionId  String                @map("roadmap_point_revision_id") @db.Uuid
  skillLevelExpectationId String                @map("skill_level_expectation_id") @db.Uuid
  role                    SkillContributionRole
  createdAt               DateTime              @default(now()) @map("created_at")

  revision   RoadmapPointRevision  @relation(fields: [roadmapPointRevisionId], references: [id], onDelete: Cascade)
  expectation SkillLevelExpectation @relation(fields: [skillLevelExpectationId], references: [id], onDelete: Restrict)

  @@unique([roadmapPointRevisionId, skillLevelExpectationId])
  @@index([skillLevelExpectationId])
  @@map("roadmap_point_skill_expectation")
}

// TeachingBlueprint — 1:1 with RoadmapPoint; TeachingBlueprint != LessonRevision.
model TeachingBlueprint {
  id                  String          @id @default(uuid(7)) @db.Uuid
  roadmapPointId      String          @unique @map("roadmap_point_id") @db.Uuid
  status              ContainerStatus @default(DRAFT)
  publishedRevisionId String?         @unique @map("published_revision_id") @db.Uuid
  createdBy           String          @map("created_by") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  point             RoadmapPoint               @relation(fields: [roadmapPointId], references: [id], onDelete: Restrict)
  createdByUser     User                       @relation("BlueprintCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  publishedRevision TeachingBlueprintRevision? @relation("BlueprintPublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: Restrict)
  revisions         TeachingBlueprintRevision[] @relation("BlueprintRevisions")

  @@map("teaching_blueprint")
}

// TeachingBlueprintRevision — immutable published revision; ordered stages are relational rows.
model TeachingBlueprintRevision {
  id                   String         @id @default(uuid(7)) @db.Uuid
  blueprintId          String         @map("blueprint_id") @db.Uuid
  versionNo            Int            @map("version_no")
  status               RevisionStatus @default(DRAFT)
  estimatedDurationMin Int?           @map("estimated_duration_min")
  reviewedBy           String?        @map("reviewed_by") @db.Uuid
  publishedBy          String?        @map("published_by") @db.Uuid
  publishedAt          DateTime?      @map("published_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  blueprint       TeachingBlueprint  @relation("BlueprintRevisions", fields: [blueprintId], references: [id], onDelete: Restrict)
  currentForBlueprint TeachingBlueprint? @relation("BlueprintPublishedRevision")
  reviewedByUser  User?              @relation("BlueprintRevReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  publishedByUser User?              @relation("BlueprintRevPublishedBy", fields: [publishedBy], references: [id], onDelete: SetNull)
  stages          TeachingBlueprintStage[]
  teachingSessions TeachingSession[]
  sourceProvenance ContentSourceProvenance[] // Content Quality V2
  contentReviews   ContentReview[] // Content Quality V2

  @@unique([blueprintId, versionNo])
  @@map("teaching_blueprint_revision")
}

// TeachingBlueprintStage — CORE relational stage identity/order/type/branch within a pinned revision.
model TeachingBlueprintStage {
  id                 String   @id @default(uuid(7)) @db.Uuid
  blueprintRevisionId String  @map("blueprint_revision_id") @db.Uuid
  stageKey           String?  @map("stage_key")
  position           Int
  stageType          String   @map("stage_type") // string registry (concept/visual/rule/example/recognition/production/...)
  branchFromStageId  String?  @map("branch_from_stage_id") @db.Uuid
  config             Json     @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at")

  revision       TeachingBlueprintRevision @relation(fields: [blueprintRevisionId], references: [id], onDelete: Cascade)
  branchFromStage TeachingBlueprintStage?  @relation("StageBranch", fields: [branchFromStageId], references: [id], onDelete: Restrict)
  branchTargets  TeachingBlueprintStage[]  @relation("StageBranch")
  bindings       TeachingBlueprintContentBinding[]
  qualityIssues  ContentQualityIssue[] // Content Quality V2
  integrityScopes EvidenceIntegrityScope[] // Content Quality V2

  @@unique([blueprintRevisionId, position])
  @@index([blueprintRevisionId, position])
  @@map("teaching_blueprint_stage")
}

// TeachingBlueprintContentBinding — stage -> immutable content revision (typed FK, XOR).
model TeachingBlueprintContentBinding {
  id               String               @id @default(uuid(7)) @db.Uuid
  blueprintStageId String               @map("blueprint_stage_id") @db.Uuid
  lessonRevisionId String?              @map("lesson_revision_id") @db.Uuid
  activityId       String?              @map("activity_id") @db.Uuid
  mediaAssetId     String?              @map("media_asset_id") @db.Uuid
  role             BlueprintBindingRole
  position         Int
  createdAt        DateTime             @default(now()) @map("created_at")

  stage          TeachingBlueprintStage @relation(fields: [blueprintStageId], references: [id], onDelete: Cascade)
  lessonRevision LessonRevision?        @relation(fields: [lessonRevisionId], references: [id], onDelete: Restrict)
  activity       Activity?              @relation(fields: [activityId], references: [id], onDelete: Restrict)
  media          MediaAsset?            @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([blueprintStageId, position])
  @@map("teaching_blueprint_content_binding")
}

// MasteryRequirement — 1:1 with RoadmapPoint (requirement owns the point FK). Point-owned canonical policy.
model MasteryRequirement {
  id                String          @id @default(uuid(7)) @db.Uuid
  roadmapPointId    String          @unique @map("roadmap_point_id") @db.Uuid
  status            ContainerStatus @default(DRAFT)
  currentRevisionId String?         @unique @map("current_revision_id") @db.Uuid
  createdBy         String          @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  point           RoadmapPoint                @relation(fields: [roadmapPointId], references: [id], onDelete: Restrict)
  createdByUser    User                       @relation("RequirementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  currentRevision MasteryRequirementRevision? @relation("RequirementCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  revisions       MasteryRequirementRevision[] @relation("RequirementRevisions")

  @@map("mastery_requirement")
}

// MasteryRequirementRevision — immutable published mastery contract.
model MasteryRequirementRevision {
  id            String         @id @default(uuid(7)) @db.Uuid
  requirementId String         @map("requirement_id") @db.Uuid
  versionNo     Int            @map("version_no")
  status        RevisionStatus @default(DRAFT)
  gates         Json           @db.JsonB // critical/cumulative gate config
  policyVersion String         @map("policy_version") // non-empty (CHECK)
  reviewedBy    String?        @map("reviewed_by") @db.Uuid
  publishedBy   String?        @map("published_by") @db.Uuid
  publishedAt   DateTime?      @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  requirement           MasteryRequirement  @relation("RequirementRevisions", fields: [requirementId], references: [id], onDelete: Restrict)
  currentForRequirement MasteryRequirement? @relation("RequirementCurrentRevision")
  reviewedByUser        User?               @relation("RequirementRevReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  publishedByUser       User?               @relation("RequirementRevPublishedBy", fields: [publishedBy], references: [id], onDelete: SetNull)
  skillExpectations     MasteryRequirementSkillExpectation[]
  evaluations           MasteryEvaluation[]

  @@unique([requirementId, versionNo])
  @@map("mastery_requirement_revision")
}

// MasteryRequirementSkillExpectation — gate referencing the EXACT expectation revision.
model MasteryRequirementSkillExpectation {
  id                              String                @id @default(uuid(7)) @db.Uuid
  requirementRevisionId           String                @map("requirement_revision_id") @db.Uuid
  skillLevelExpectationRevisionId String                @map("skill_level_expectation_revision_id") @db.Uuid
  role                            SkillContributionRole
  requiredEvidenceKinds           Json                  @map("required_evidence_kinds") @db.JsonB
  minIndependence                 Int?                  @map("min_independence") @db.SmallInt
  createdAt                       DateTime              @default(now()) @map("created_at")

  requirementRevision MasteryRequirementRevision    @relation(fields: [requirementRevisionId], references: [id], onDelete: Cascade)
  expectationRevision SkillLevelExpectationRevision @relation(fields: [skillLevelExpectationRevisionId], references: [id], onDelete: Restrict)

  @@unique([requirementRevisionId, skillLevelExpectationRevisionId])
  @@index([skillLevelExpectationRevisionId])
  @@map("mastery_requirement_skill_expectation")
}
