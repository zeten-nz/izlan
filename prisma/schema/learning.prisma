// LearnerSignal (TD-40) — actionable insight; category_code string registry
model LearnerSignal {
  id              String       @id @default(uuid(7)) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  subjectId       String       @map("subject_id") @db.Uuid
  type            String // REPEATED_MISTAKE / REVIEW_DUE / CONSISTENCY_RISK ... (small set, registry)
  skillId         String?      @map("skill_id") @db.Uuid
  lessonId        String?      @map("lesson_id") @db.Uuid
  topicId         String?      @map("topic_id") @db.Uuid
  categoryCode    String?      @map("category_code") // mistake taxonomy — registry (TD-40/90)
  strength        Int          @default(0)
  evidenceRefs    Json?        @map("evidence_refs") @db.JsonB // ataylab loose (TD-92)
  status          SignalStatus @default(ACTIVE)
  firstDetectedAt DateTime     @default(now()) @map("first_detected_at")
  lastSeenAt      DateTime     @default(now()) @map("last_seen_at")
  resolvedAt      DateTime?    @map("resolved_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
