// ============================================================================
// V2 LEARNER FACTS — WAVE C (docs/learning-v2/DATA_MODEL_V2_PRISMA_CHANGE_PLAN.md §10–§15)
// Append-only immutable facts + evidence lineage. Historical facts never rewritten.
// ============================================================================

// PlacementDecision — immutable placement fact. Present here as the structural provenance target
// for PointAcquisitionEvent(VALIDATED); the VALIDATED flow itself (placement engine) is a later phase.
model PlacementDecision {
  id                      String   @id @default(uuid(7)) @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  subjectId               String   @map("subject_id") @db.Uuid
  trackId                 String?  @map("track_id") @db.Uuid
  sourceAttemptId         String?  @map("source_assessment_attempt_id") @db.Uuid
  policyVersion           String   @map("policy_version") // non-empty (CHECK)
  recommendedStudyLevelId String?  @map("recommended_study_level_id") @db.Uuid
  supersedesDecisionId    String?  @map("supersedes_decision_id") @db.Uuid // new->old; old row never mutated
  clientRequestId         String?  @map("client_request_id")
  snapshot                Json     @db.JsonB // descriptive decision-time snapshot; NOT the FK graph
  decidedAt               DateTime @default(now()) @map("decided_at")
  createdAt               DateTime @default(now()) @map("created_at")

  user                  User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  subject               Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  track                 Track?              @relation(fields: [trackId], references: [id], onDelete: Restrict)
  sourceAttempt         AssessmentAttempt?  @relation(fields: [sourceAttemptId], references: [id], onDelete: Restrict)
  recommendedStudyLevel Level?              @relation("PlacementRecommendedLevel", fields: [recommendedStudyLevelId], references: [id], onDelete: Restrict)
  supersedesDecision    PlacementDecision?  @relation("PlacementSupersession", fields: [supersedesDecisionId], references: [id], onDelete: Restrict)
  supersededBy          PlacementDecision[] @relation("PlacementSupersession")
  acquisitionEvents     PointAcquisitionEvent[]
  roadmapGenerations    LearnerRoadmapGeneration[]
  validations           PlacementDecisionValidation[] // Placement V2 — normalized validated areas

  @@index([userId, subjectId, decidedAt])
  // Partial UNIQUE (custom SQL): uq_placement_decision_attempt_policy (source_assessment_attempt_id, policy_version) WHERE source_assessment_attempt_id IS NOT NULL
  // Partial UNIQUE (custom SQL): uq_placement_decision_client_request (user_id, client_request_id) WHERE client_request_id IS NOT NULL
  @@map("placement_decision")
}

// TeachingSession — per-point V2 execution state; pins point-context + teaching-content revisions.
// Session completion != LEARNED (that is a mastery-evaluated PointAcquisitionEvent).
model TeachingSession {
  id                     String                @id @default(uuid(7)) @db.Uuid
  userId                 String                @map("user_id") @db.Uuid
  roadmapPointId         String                @map("roadmap_point_id") @db.Uuid
  roadmapPointRevisionId String                @map("roadmap_point_revision_id") @db.Uuid // point-context history
  blueprintRevisionId    String                @map("blueprint_revision_id") @db.Uuid // teaching-content history
  roadmapGenerationId    String?               @map("roadmap_generation_id") @db.Uuid
  status                 TeachingSessionStatus @default(NOT_STARTED)
  currentStep            Json?                 @map("current_step") @db.JsonB // resume: stage/branch/hints
  startedAt              DateTime?             @map("started_at")
  completedAt            DateTime?             @map("completed_at")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  user              User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  point             RoadmapPoint              @relation(fields: [roadmapPointId], references: [id], onDelete: Restrict)
  pointRevision     RoadmapPointRevision      @relation(fields: [roadmapPointRevisionId], references: [id], onDelete: Restrict)
  blueprintRevision TeachingBlueprintRevision @relation(fields: [blueprintRevisionId], references: [id], onDelete: Restrict)
  generation        LearnerRoadmapGeneration? @relation(fields: [roadmapGenerationId], references: [id], onDelete: SetNull)
  contentPins       TeachingSessionContentPin[]
  activityAttempts  ActivityAttempt[]
  measurements      SkillMeasurement[]

  @@index([userId, status])
  @@index([userId, roadmapPointId, status])
  // Partial UNIQUE (custom SQL): uq_teaching_session_nonterminal (user_id, roadmap_point_id) WHERE status NOT IN ('COMPLETED','ABANDONED')
  @@map("teaching_session")
}

// TeachingSessionContentPin — resolved/encountered content-revision set for a session (fact).
model TeachingSessionContentPin {
  id                String   @id @default(uuid(7)) @db.Uuid
  teachingSessionId String   @map("teaching_session_id") @db.Uuid
  lessonRevisionId  String?  @map("lesson_revision_id") @db.Uuid
  activityId        String?  @map("activity_id") @db.Uuid
  mediaAssetId      String?  @map("media_asset_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  session        TeachingSession @relation(fields: [teachingSessionId], references: [id], onDelete: Cascade)
  lessonRevision LessonRevision? @relation(fields: [lessonRevisionId], references: [id], onDelete: Restrict)
  activity       Activity?       @relation(fields: [activityId], references: [id], onDelete: Restrict)
  media          MediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([teachingSessionId])
  // CHECK (custom SQL): chk_teaching_session_pin_xor — exactly one content FK non-null
  @@map("teaching_session_content_pin")
}

// SkillMeasurementEvidenceRef — relational raw-evidence provenance (XOR source). Multi-skill safe.
model SkillMeasurementEvidenceRef {
  id                   String   @id @default(uuid(7)) @db.Uuid
  skillMeasurementId   String   @map("skill_measurement_id") @db.Uuid
  assessmentResponseId String?  @map("assessment_response_id") @db.Uuid
  activityAttemptId    String?  @map("activity_attempt_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")

  measurement        SkillMeasurement    @relation(fields: [skillMeasurementId], references: [id], onDelete: Cascade)
  assessmentResponse AssessmentResponse? @relation(fields: [assessmentResponseId], references: [id], onDelete: Restrict)
  activityAttempt    ActivityAttempt?    @relation(fields: [activityAttemptId], references: [id], onDelete: Restrict)

  @@index([assessmentResponseId])
  @@index([activityAttemptId])
  @@index([skillMeasurementId])
  // CHECK (custom SQL): chk_smer_source_xor — exactly one source FK non-null
  // Partial UNIQUE per source (custom SQL): (measurement, source) — NOT global (one attempt feeds many skills)
  @@map("skill_measurement_evidence_ref")
}

// MasteryEvaluation — immutable historical evaluation vs the exact requirement revision. != acquisition.
model MasteryEvaluation {
  id                     String                   @id @default(uuid(7)) @db.Uuid
  userId                 String                   @map("user_id") @db.Uuid
  roadmapPointId         String                   @map("roadmap_point_id") @db.Uuid
  roadmapPointRevisionId String                   @map("roadmap_point_revision_id") @db.Uuid // point-context
  requirementRevisionId  String                   @map("mastery_requirement_revision_id") @db.Uuid // the exact gate
  outcome                MasteryEvaluationOutcome
  policyVersion          String                   @map("policy_version") // non-empty (CHECK)
  evidenceCutoffAt       DateTime                 @map("evidence_cutoff_at") // indexable watermark
  evidenceBoundaryKey    String?                  @map("evidence_boundary_key")
  gateSummary            Json                     @map("gate_summary") @db.JsonB
  evaluatedAt            DateTime                 @default(now()) @map("evaluated_at")
  createdAt              DateTime                 @default(now()) @map("created_at")

  user                User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  point               RoadmapPoint               @relation(fields: [roadmapPointId], references: [id], onDelete: Restrict)
  pointRevision       RoadmapPointRevision       @relation(fields: [roadmapPointRevisionId], references: [id], onDelete: Restrict)
  requirementRevision MasteryRequirementRevision @relation(fields: [requirementRevisionId], references: [id], onDelete: Restrict)
  evidence            MasteryEvaluationEvidence[]
  acquisitionEvents   PointAcquisitionEvent[]

  @@unique([userId, roadmapPointId, requirementRevisionId, evidenceCutoffAt], map: "uq_mastery_evaluation_idem") // idempotency (all cols NOT NULL → plain unique; Prisma-managed)
  @@index([userId, roadmapPointId, evaluatedAt])
  @@map("mastery_evaluation")
}

// MasteryEvaluationEvidence — pins the exact SkillMeasurement set the evaluation used (no value copy).
model MasteryEvaluationEvidence {
  id                  String   @id @default(uuid(7)) @db.Uuid
  masteryEvaluationId String   @map("mastery_evaluation_id") @db.Uuid
  skillMeasurementId  String   @map("skill_measurement_id") @db.Uuid
  evidenceRole        Int?     @map("evidence_role") @db.SmallInt
  createdAt           DateTime @default(now()) @map("created_at")

  evaluation  MasteryEvaluation @relation(fields: [masteryEvaluationId], references: [id], onDelete: Cascade)
  measurement SkillMeasurement  @relation(fields: [skillMeasurementId], references: [id], onDelete: Restrict)

  @@unique([masteryEvaluationId, skillMeasurementId])
  @@index([skillMeasurementId])
  @@index([masteryEvaluationId])
  @@map("mastery_evaluation_evidence")
}

// PointAcquisitionEvent — append-only LEARNED/VALIDATED fact on a STABLE point (survives regeneration).
model PointAcquisitionEvent {
  id                     String               @id @default(uuid(7)) @db.Uuid
  userId                 String               @map("user_id") @db.Uuid
  roadmapPointId         String               @map("roadmap_point_id") @db.Uuid // durable identity
  roadmapPointRevisionId String               @map("roadmap_point_revision_id") @db.Uuid // historical context
  acquisitionType        PointAcquisitionType @map("acquisition_type")
  masteryEvaluationId    String?              @map("mastery_evaluation_id") @db.Uuid // LEARNED provenance
  placementDecisionId    String?              @map("placement_decision_id") @db.Uuid // VALIDATED provenance
  validationApplicationPolicyVersion String?  @map("validation_application_policy_version")
  policyVersion          String?              @map("policy_version")
  acquiredAt             DateTime             @default(now()) @map("acquired_at")
  createdAt              DateTime             @default(now()) @map("created_at")

  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  point             RoadmapPoint         @relation(fields: [roadmapPointId], references: [id], onDelete: Restrict)
  pointRevision     RoadmapPointRevision @relation(fields: [roadmapPointRevisionId], references: [id], onDelete: Restrict)
  masteryEvaluation MasteryEvaluation?   @relation(fields: [masteryEvaluationId], references: [id], onDelete: Restrict)
  placementDecision PlacementDecision?   @relation(fields: [placementDecisionId], references: [id], onDelete: Restrict)
  validationRefs    PointAcquisitionValidationRef[] // Placement V2 — VALIDATED lineage

  @@index([userId, roadmapPointId, acquiredAt])
  // CHECK (custom SQL): chk_pae_provenance — LEARNED⇒eval set & placement null; VALIDATED⇒placement set & eval null
  // Partial UNIQUE (custom SQL): uq_pae_learned / uq_pae_validated — cause-based idempotency (not global)
  @@map("point_acquisition_event")
}

// ============================================================================
// V2 DERIVED PROJECTIONS — WAVE D (§16). Rebuildable; non-authoritative caches.
// ============================================================================

// LearnerRoadmapGeneration — versioned derived generation (V1 LearnerRoadmap untouched).
model LearnerRoadmapGeneration {
  id                        String                  @id @default(uuid(7)) @db.Uuid
  userId                    String                  @map("user_id") @db.Uuid
  subjectId                 String                  @map("subject_id") @db.Uuid
  trackId                   String                  @map("track_id") @db.Uuid
  generationNo              Int                     @map("generation_no")
  engineVersion             String                  @map("engine_version") // non-empty (CHECK)
  sourcePlacementDecisionId String?                 @map("source_placement_decision_id") @db.Uuid
  status                    RoadmapGenerationStatus @default(CURRENT)
  supersedesGenerationId    String?                 @map("supersedes_generation_id") @db.Uuid
  generatedAt               DateTime                @default(now()) @map("generated_at")
  createdAt                 DateTime                @default(now()) @map("created_at")

  user                    User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  subject                 Subject                   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  track                   Track                     @relation(fields: [trackId], references: [id], onDelete: Restrict)
  sourcePlacementDecision PlacementDecision?        @relation(fields: [sourcePlacementDecisionId], references: [id], onDelete: Restrict)
  supersedesGeneration    LearnerRoadmapGeneration? @relation("GenerationSupersession", fields: [supersedesGenerationId], references: [id], onDelete: SetNull)
  supersededBy            LearnerRoadmapGeneration[] @relation("GenerationSupersession")
  projections             RoadmapPointProjection[]
  teachingSessions        TeachingSession[]

  @@unique([userId, subjectId, generationNo])
  @@index([userId, subjectId, status])
  // Partial UNIQUE (custom SQL): uq_roadmap_generation_current (user_id, subject_id) WHERE status = 'CURRENT'
  @@map("learner_roadmap_generation")
}

// RoadmapPointProjection — per generation x point materialized view. All 3 states non-authoritative.
model RoadmapPointProjection {
  id                     String                   @id @default(uuid(7)) @db.Uuid
  roadmapGenerationId    String                   @map("roadmap_generation_id") @db.Uuid
  roadmapPointId         String                   @map("roadmap_point_id") @db.Uuid
  roadmapPointRevisionId String                   @map("roadmap_point_revision_id") @db.Uuid // graph-version pin
  sortOrder              Int                      @map("sort_order")
  acquisition            PointAcquisitionType? // derived cache (NULL = none)
  availability           RoadmapAvailabilityState @default(LOCKED)
  attention              RoadmapAttentionState    @default(NONE)
  derivedMeta            Json?                    @map("derived_meta") @db.JsonB
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  generation    LearnerRoadmapGeneration @relation(fields: [roadmapGenerationId], references: [id], onDelete: Cascade)
  point         RoadmapPoint             @relation(fields: [roadmapPointId], references: [id], onDelete: Restrict)
  pointRevision RoadmapPointRevision     @relation(fields: [roadmapPointRevisionId], references: [id], onDelete: Restrict)

  @@unique([roadmapGenerationId, roadmapPointId])
  @@index([roadmapGenerationId, sortOrder])
  @@map("roadmap_point_projection")
}

// ============================================================================
// PLACEMENT VALIDATION LINEAGE (docs/learning-v2/DATA_MODEL_V2_PRISMA_CHANGE_PLAN §10, §15a)
// PlacementDecision -> PlacementDecisionValidation -> PointAcquisitionValidationRef ->
// PointAcquisitionEvent(VALIDATED). Immutable; never JSON. VALIDATED != COMPLETED/LEARNED.
// ============================================================================

// PlacementDecisionValidation — one validated area per row (XOR target). What Roadmap consumes to write VALIDATED.
model PlacementDecisionValidation {
  id                              String                        @id @default(uuid(7)) @db.Uuid
  placementDecisionId             String                        @map("placement_decision_id") @db.Uuid
  targetKind                      PlacementValidationTargetKind @map("target_kind")
  skillLevelExpectationRevisionId String?                       @map("skill_level_expectation_revision_id") @db.Uuid
  roadmapPointId                  String?                       @map("roadmap_point_id") @db.Uuid
  roadmapPointRevisionId          String?                       @map("roadmap_point_revision_id") @db.Uuid // set iff roadmapPointId set (CHECK)
  validationKind                  PlacementValidationKind       @map("validation_kind")
  policyVersion                   String                        @map("policy_version")
  createdAt                       DateTime                      @default(now()) @map("created_at")

  decision            PlacementDecision              @relation(fields: [placementDecisionId], references: [id], onDelete: Cascade)
  expectationRevision SkillLevelExpectationRevision? @relation(fields: [skillLevelExpectationRevisionId], references: [id], onDelete: Restrict)
  point               RoadmapPoint?                  @relation(fields: [roadmapPointId], references: [id], onDelete: Restrict)
  pointRevision       RoadmapPointRevision?          @relation(fields: [roadmapPointRevisionId], references: [id], onDelete: Restrict)
  validationRefs      PointAcquisitionValidationRef[]

  @@index([placementDecisionId])
  // CHECK chk_placement_validation_target_xor: exactly one of {expectationRev, point} non-null
  // CHECK chk_pdv_point_revision_paired: roadmap_point_revision_id set iff roadmap_point_id set
  // Partial UNIQUE uq_pdv_point (placement_decision_id, roadmap_point_id) WHERE roadmap_point_id IS NOT NULL
  // Partial UNIQUE uq_pdv_expectation (placement_decision_id, skill_level_expectation_revision_id) WHERE ... IS NOT NULL
  @@map("placement_decision_validation")
}

// PointAcquisitionValidationRef — pins the exact PlacementDecisionValidation facts a VALIDATED event consumed.
model PointAcquisitionValidationRef {
  id                            String   @id @default(uuid(7)) @db.Uuid
  pointAcquisitionEventId       String   @map("point_acquisition_event_id") @db.Uuid
  placementDecisionValidationId String   @map("placement_decision_validation_id") @db.Uuid
  createdAt                     DateTime @default(now()) @map("created_at")

  event      PointAcquisitionEvent       @relation(fields: [pointAcquisitionEventId], references: [id], onDelete: Cascade)
  validation PlacementDecisionValidation @relation(fields: [placementDecisionValidationId], references: [id], onDelete: Restrict)

  @@unique([pointAcquisitionEventId, placementDecisionValidationId])
  @@index([placementDecisionValidationId])
  @@index([pointAcquisitionEventId])
  @@map("point_acquisition_validation_ref")
}
