  position        Int
  status          RoadmapItemStatus @default(PENDING)
  source          RoadmapItemSource
  reason          String?
  roadmapChangeId String?           @map("roadmap_change_id") @db.Uuid
  params          Json?             @db.JsonB
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  roadmap       LearnerRoadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  checkpoint    Checkpoint?       @relation(fields: [checkpointId], references: [id], onDelete: Restrict)
  skill         Skill?            @relation(fields: [skillId], references: [id], onDelete: Restrict)
  roadmapChange RoadmapChange?    @relation(fields: [roadmapChangeId], references: [id], onDelete: SetNull)
  attempts      ActivityAttempt[]

  @@index([roadmapId, position])
  @@map("roadmap_item")
}

model LearnerRecommendation {
