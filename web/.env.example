# Izlan Methodist CMS (web) — environment example. Copy to .env.local for local development.
#
# Base URL of the Izlan backend (NestJS). No trailing slash. The CMS calls <base>/api/...
# The backend must include this web app's origin in its CORS_ORIGINS allowlist (credentialed CORS),
# because the refresh flow uses `credentials: include`. For the default dev ports:
#   - backend: http://localhost:3000  (Nest default PORT)
#   - web:     http://localhost:4000  (this app's `npm run dev`)
# so add http://localhost:4000 to the backend CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
