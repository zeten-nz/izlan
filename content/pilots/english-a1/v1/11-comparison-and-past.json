            "payload": { "schemaVersion": "lesson-activity-structured/v1", "format": "fill_blank", "prompt": "Bo'sh joyni to'ldiring (was/were): biz kecha uyda edik.", "segments": [ { "text": "We " }, { "blankId": "b1" }, { "text": " at home yesterday." } ], "blanks": { "b1": { "accepted": ["were"] } }, "normalization": { "caseFold": true, "collapseWhitespace": true }, "remediation": "we → were." }
