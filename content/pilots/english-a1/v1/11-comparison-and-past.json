            "skillCodes": ["ENG-A1-COMPARATIVES"],
            "payload": { "schemaVersion": "lesson-activity-structured/v1", "format": "fill_blank", "prompt": "Bo'sh joyni to'ldiring (qiyosiy shakl, 'big'): bu quti u qutidan kattaroq.", "segments": [ { "text": "This box is " }, { "blankId": "b1" }, { "text": " than that box." } ], "blanks": { "b1": { "accepted": ["bigger"] } }, "normalization": { "caseFold": true, "collapseWhitespace": true }, "remediation": "big → bigger (g takrorlanadi)." }
