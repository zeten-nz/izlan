            "payload": { "schemaVersion": "lesson-activity-objective/v1", "format": "single_choice", "prompt": "There are five ___ on the table. (book)", "options": [ { "id": "a", "text": "book" }, { "id": "b", "text": "books" }, { "id": "c", "text": "bookes" } ], "answerKey": { "correctOptionIds": ["b"] } }
