            "payload": { "schemaVersion": "lesson-activity-objective/v1", "format": "single_choice", "prompt": "Two ___ are in the office. (woman)", "options": [ { "id": "a", "text": "womans" }, { "id": "b", "text": "womens" }, { "id": "c", "text": "women" } ], "answerKey": { "correctOptionIds": ["c"] } }
