            "payload": { "schemaVersion": "lesson-activity-objective/v1", "format": "single_choice", "prompt": "My city has many ___. (bus)", "options": [ { "id": "a", "text": "buss" }, { "id": "b", "text": "buses" }, { "id": "c", "text": "busies" } ], "answerKey": { "correctOptionIds": ["b"] } }
