    {
      "contentKey": "ENG-A1-004-BE-NEGATIVE",
      "slug": "eng-a1-004-be-negative",
      "sortOrder": 10,
      "skillCodes": ["ENG-A1-BE-NEGATIVE", "ENG-A1-BE-AFFIRMATIVE"],
