            "skillCodes": ["ENG-A1-QUESTION-WORDS"],
            "payload": { "schemaVersion": "lesson-activity-structured/v1", "format": "fill_blank", "prompt": "Bo'sh joyni to'ldiring (do/does): u qayerda yashaydi?", "segments": [ { "text": "Where " }, { "blankId": "b1" }, { "text": " she live?" } ], "blanks": { "b1": { "accepted": ["does"] } }, "normalization": { "caseFold": true, "collapseWhitespace": true }, "remediation": "she → does." }
          },
          {
            "type": "MASTERY_TEST",
