            "payload": { "schemaVersion": "lesson-activity-objective/v1", "format": "single_choice", "prompt": "The cat is ___ the chair. (ostida)", "options": [ { "id": "a", "text": "on" }, { "id": "b", "text": "in" }, { "id": "c", "text": "under" } ], "answerKey": { "correctOptionIds": ["c"] } }
